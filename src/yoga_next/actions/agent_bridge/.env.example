# Agent Bridge 配置示例文件
# 复制此文件为 .env 并填写实际的配置值

# SSH连接配置
SSH_HOST=your-remote-server.com
SSH_USERNAME=ubuntu
SSH_PASSWORD=your-ssh-password
SSH_PORT=22

# 远程工作目录
REMOTE_WORKSPACE=~/agent_bridge_workspace

# 本地下载目录
LOCAL_DOWNLOADS=./downloads

# Python虚拟环境路径
VENV_PATH=~/agent_bridge_venv

# Notion API配置（可选）
NOTION_TOKEN=your-notion-integration-token

# 连接超时配置
TIMEOUT=30
RETRY_TIMES=3

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=agent_bridge.log